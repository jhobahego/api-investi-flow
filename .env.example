# Database - Neon PostgreSQL
DATABASE_URL=postgresql://user:password@host/database?sslmode=require&channel_binding=require
DATABASE_HOST=your-database-host
DATABASE_PORT=5432
DATABASE_NAME=your_database_name
DATABASE_USER=your_database_user
DATABASE_PASSWORD=your_database_password

# JWT Security
SECRET_KEY=your-secret-key-here-generate-a-secure-one
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# API Configuration
API_V1_STR=/api/v1
PROJECT_NAME=InvestiFlow API
BACKEND_CORS_ORIGIN=http://localhost:5173

# File Upload
MAX_FILE_SIZE=10485760  # 10MB
UPLOAD_FOLDER=uploads
ALLOWED_EXTENSIONS=pdf,doc,docx,txt,md

# AI Services (placeholder - add your keys)
OPENAI_API_KEY=your-openai-api-key
GOOGLE_AI_API_KEY=your-google-ai-api-key

# AI Models
AI_MODEL_CHAT=gemini-2.5-flash-lite
AI_MODEL_SUGGESTIONS=gemini-2.5-flash-lite
AI_MODEL_CITATIONS=gemini-2.5-flash-lite
AI_MODEL_BIBLIOGRAPHY=gemini-3.1-pro-preview
# Embeddings: `gemini-embedding-001` is the current model. `text-embedding-004`
# is retired and returns 404. Keep output_dimensionality=768 (enforced by the
# application) so the pgvector column stays valid.
AI_MODEL_EMBEDDING=gemini-embedding-001

# Celery / RAG indexing worker
# Local host (docker compose maps Redis to host port 6380):
CELERY_BROKER_URL=redis://localhost:6380/0
CELERY_RESULT_BACKEND=redis://localhost:6380/0
RAG_INDEXING_ENABLED=true

# Upstash (TLS): copy the Redis URL from the Upstash console and use rediss://
# Free plan has a single database and only supports SELECT 0, so Celery and the
# cost guard share that database. Their keys do not collide, but they share the
# command quota; use a second database (paid) if you need full isolation.
# CELERY_BROKER_URL=rediss://default:<password>@<endpoint>:6379/0
# CELERY_RESULT_BACKEND=rediss://default:<password>@<endpoint>:6379/0

# Cost guard uses the limits library async prefix:
# RATE_LIMIT_REDIS_URL=async+rediss://default:<password>@<endpoint>:6379

# Gemini cost guard Phase 1 (free Upstash Redis)
# Local dev uses plain redis; production (Upstash) uses TLS rediss.
RATE_LIMIT_REDIS_URL=async+redis://localhost:6379
# Example Upstash: async+rediss://default:YOUR_TOKEN@your-instance.upstash.io:6379
RATE_LIMIT_ENABLED=true
GEMINI_GLOBAL_TOKENS_DAY=1000000

# Trusted proxy IPs for uvicorn --proxy-headers (real client IP behind Render).
# Production (Render): "*" or the observed internal CIDR.
FORWARDED_ALLOW_IPS=*

# Email (for notifications)
SMTP_TLS=True
SMTP_PORT=587
SMTP_HOST=smtp.gmail.com
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-email-password

# Environment
ENVIRONMENT=development
DEBUG=True
