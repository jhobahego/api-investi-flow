# Copy to .env.staging-worker (gitignored) and fill with real values.
# Used by the local Celery worker that consumes the staging RAG queue.

# Neon staging/production database (same one used by the staging API).
DATABASE_URL=postgresql://<user>:<password>@<neon-host>/<database>?sslmode=require

# Upstash Redis (TLS). Use the same database as the staging API.
# Free Upstash has a single database and only db 0; Celery and the cost guard
# share it, but their keys do not collide.
CELERY_BROKER_URL=rediss://default:<password>@<endpoint>:6379/0
CELERY_RESULT_BACKEND=rediss://default:<password>@<endpoint>:6379/0

# Google GenAI (same key as the API).
GOOGLE_AI_API_KEY=<google-ai-api-key>

# Embeddings + RAG toggle.
AI_MODEL_EMBEDDING=gemini-embedding-001
RAG_INDEXING_ENABLED=true

# Same secret as the API (the worker does not issue tokens, but settings require it).
SECRET_KEY=<same-secret-as-the-api>

# Optional. Not needed for the default text-payload path.
UPLOAD_FOLDER=uploads
ENVIRONMENT=staging
